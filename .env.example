# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL container running on port 5433 to avoid host port collisions)
POSTGRES_USER=echogpt
POSTGRES_PASSWORD=echogpt_password
POSTGRES_DB=echogpt_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://echogpt:echogpt_password@localhost:5433/echogpt_db?schema=public"

# Authentication (JWT)
JWT_ACCESS_SECRET="replace_with_a_secure_jwt_access_secret_min_32_chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="replace_with_a_secure_jwt_refresh_secret_min_32_chars"
JWT_REFRESH_EXPIRATION="7d"

# Security (AES-256-CBC/GCM encryption key - exactly 32 bytes for storing provider keys)
ENCRYPTION_KEY="01234567890123456789012345678901"

# AI Providers (Optional fallback / test defaults)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Web Search Provider (Optional for testing)
BRAVE_SEARCH_API_KEY=""

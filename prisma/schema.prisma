datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  ADMIN
  USER
}

enum PlanType {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum ProviderType {
  OPENAI
  CLAUDE
  GEMINI
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  firstName     String?        @map("first_name")
  lastName      String?        @map("last_name")
  isActive      Boolean        @default(true) @map("is_active")
  isVerified    Boolean        @default(false) @map("is_verified")
  roleId        String         @map("role_id")
  role          Role           @relation(fields: [roleId], references: [id])
  subscription  Subscription?
  refreshTokens RefreshToken[]
  conversations Conversation[]
  webSearches   WebSearch[]
  apiUsageLogs  ApiUsageLog[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([email])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String             @unique @map("user_id")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType          PlanType           @default(FREE) @map("plan_type")
  status            SubscriptionStatus @default(ACTIVE)
  maxRequestsPerDay Int                @default(20) @map("max_requests_per_day")
  usedRequestsToday Int                @default(0) @map("used_requests_today")
  lastResetDate     DateTime           @default(now()) @map("last_reset_date")
  startDate         DateTime           @default(now()) @map("start_date")
  expiresAt         DateTime?          @map("expires_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@map("subscriptions")
}

model AiProvider {
  id              String         @id @default(uuid())
  name            ProviderType   @unique
  displayName     String         @map("display_name")
  baseUrl         String?        @map("base_url")
  encryptedApiKey String?        @map("encrypted_api_key")
  isEnabled       Boolean        @default(true) @map("is_enabled")
  isDefault       Boolean        @default(false) @map("is_default")
  defaultModel    String         @map("default_model")
  availableModels String[]       @map("available_models")
  conversations   Conversation[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("ai_providers")
}

model Conversation {
  id         String      @id @default(uuid())
  title      String      @default("New Conversation")
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String?     @map("provider_id")
  provider   AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  modelUsed  String?     @map("model_used")
  messages   Message[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String       @map("conversation_id")
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String
  promptTokens     Int?         @map("prompt_tokens")
  completionTokens Int?         @map("completion_tokens")
  totalTokens      Int?         @map("total_tokens")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

model WebSearch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  results   Json?
  cached    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([query])
  @@map("web_searches")
}

model ApiUsageLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint   String
  method     String
  statusCode Int      @map("status_code")
  latencyMs  Int      @map("latency_ms")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([endpoint])
  @@index([createdAt])
  @@map("api_usage_logs")
}
